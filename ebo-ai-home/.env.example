TZ=America/Toronto

# EBO HOME account. Keep the real values only in .env; never commit that file.
EBO_EMAIL=
EBO_PASSWORD=
EBO_PAYLOAD_KEY=
EBO_SIGN_KEY=
EBO_API_TOKEN=replace-with-a-long-random-value

# Example only: replace with the Windows host address on your own LAN.
EBO_HOST_IP=192.168.1.100

# Defaults for an international EBO HOME account. Change only if the account uses another region.
EBO_REGION=GB
EBO_CLOUD_HOST=ebox-eu.enabotserverintl.com

# Persistent EBO Engine log under the host-mounted ebo-data directory.
EBO_HOST_LOG_PATH=/data/logs/ebo-engine.log
EBO_HOST_LOG_MAX_BYTES=10485760
EBO_HOST_LOG_BACKUP_COUNT=5

# Agora audio processing inside ebo-engine. Start with all three disabled and enable one at a time.
EBO_AGORA_AEC_ENABLED=false
EBO_AGORA_NOISE_SUPPRESSION_ENABLED=false
EBO_AGORA_AGC_ENABLED=false

# Realtime assistant. Keep the real OpenAI key only in .env.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_OUTPUT_SPEED=1.0
# audio speaks and also returns a transcript; text intentionally produces no EBO speech.
OPENAI_REALTIME_OUTPUT_MODALITY=audio
# Blank keeps the selected model's default. Other values: minimal, low, medium, high, xhigh.
OPENAI_REALTIME_REASONING_EFFORT=
# inf or an integer from 1 to 4096.
OPENAI_REALTIME_MAX_OUTPUT_TOKENS=inf
OPENAI_REALTIME_INCLUDE_TRANSCRIPTION_LOGPROBS=false

# Final transcript after each VAD-committed speech turn (lower cost than live captions).
OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-transcribe
# delay is only supported by gpt-realtime-whisper: minimal, low, medium, high, xhigh.
OPENAI_INPUT_TRANSCRIPTION_DELAY=
# JSON string arrays. Keywords/languages are supported by gpt-transcribe and gpt-live-transcribe.
OPENAI_INPUT_TRANSCRIPTION_KEYWORDS_JSON=[]
OPENAI_INPUT_TRANSCRIPTION_LANGUAGE=
OPENAI_INPUT_TRANSCRIPTION_LANGUAGES_JSON=[]
OPENAI_INPUT_TRANSCRIPTION_PROMPT=

# Optional server-stored OpenAI prompt. Direct EBO_ASSISTANT_INSTRUCTIONS still overrides overlaps.
OPENAI_REALTIME_PROMPT_ID=
OPENAI_REALTIME_PROMPT_VERSION=
OPENAI_REALTIME_PROMPT_VARIABLES_JSON={}

# Advanced tool and trace pass-through. Local function tools need an executor not provided here.
# Leave parallel/tool-choice blank to use the server default. TOOL_CHOICE also accepts a JSON object.
OPENAI_REALTIME_PARALLEL_TOOL_CALLS=
OPENAI_REALTIME_TOOLS_JSON=[]
OPENAI_REALTIME_TOOL_CHOICE=
# off, auto, or a one-line JSON object with workflow_name/group_id/metadata.
OPENAI_REALTIME_TRACING=off

# auto, disabled, or retention_ratio. Ratio/token values apply only to retention_ratio.
OPENAI_REALTIME_TRUNCATION_TYPE=retention_ratio
OPENAI_REALTIME_RETENTION_RATIO=0.8
OPENAI_REALTIME_POST_INSTRUCTIONS_TOKENS=8000

# EBO is usually a far-field room microphone. Raise the threshold gradually if
# normal household noise still triggers speech turns.
REALTIME_INPUT_NOISE_REDUCTION=far_field
REALTIME_TURN_DETECTION_TYPE=server_vad
REALTIME_VAD_THRESHOLD=0.65
REALTIME_VAD_PREFIX_PADDING_MS=300
REALTIME_VAD_SILENCE_DURATION_MS=650
# 0 means disabled. This field applies to server_vad.
REALTIME_VAD_IDLE_TIMEOUT_MS=0
# Used only when REALTIME_TURN_DETECTION_TYPE=semantic_vad.
REALTIME_SEMANTIC_VAD_EAGERNESS=auto
# Keep VAD speech boundaries, but validate the final transcript locally before replying.
REALTIME_VAD_CREATE_RESPONSE=false
REALTIME_VAD_INTERRUPT_RESPONSE=true

EBO_TRANSCRIPT_PATH=/data/transcripts.jsonl
# Model replies are durable: each WAV has a matching .txt, plus a JSONL index.
EBO_OUTPUT_AUDIO_DIR=/data/replies
EBO_ASSISTANT_TRANSCRIPT_PATH=/data/assistant_outputs.jsonl

# Low-latency speaker path. The WebSocket is exposed only inside the Docker network.
EBO_TALK_STREAM_URL=ws://ebo-engine:8200/talk
EBO_STREAM_PREBUFFER_MS=200
EBO_STREAM_CONNECT_TIMEOUT_SECONDS=10

# Echo-aware local barge-in. The Realtime server does not auto-interrupt while this is on.
EBO_BARGE_IN_ENABLED=true
EBO_BARGE_IN_CONFIRM_MS=300
EBO_BARGE_IN_PREROLL_MS=500
EBO_BARGE_IN_VAD_MODE=2
EBO_BARGE_IN_ECHO_CORRELATION=0.65
EBO_BARGE_IN_RESIDUAL_RATIO=0.45

# A Realtime session has a hard 60-minute limit. Rotate at 55 minutes, and keep
# 59 minutes as an emergency deadline if somebody is still speaking at minute 55.
REALTIME_SESSION_REFRESH_SECONDS=3300
REALTIME_SESSION_HARD_DEADLINE_SECONDS=3540
REALTIME_HANDOFF_TIMEOUT_SECONDS=20
REALTIME_HANDOFF_MEMORY_CHARS=4000
# On an unexpected network reconnect, replay only completed turns newer than this.
# Set 0 to disable unexpected-reconnect dialogue replay.
REALTIME_RECONNECT_MEMORY_MAX_AGE_SECONDS=900

# Session-boundary memory audit only (not every request). UTF-8 JSONL on the host mount.
# 1 MiB per file, current + 3 backups = at most 4 MiB with these settings.
EBO_MEMORY_LOG_PATH=/data/logs/session-memory.jsonl
EBO_MEMORY_LOG_MAX_BYTES=1048576
EBO_MEMORY_LOG_BACKUP_COUNT=3

# context: motion-selected frames silently update what the assistant can see.
# announce: every accepted motion frame also asks the assistant to speak.
EBO_VISUAL_MODE=context

# true is recommended for an always-on assistant: if RTSP disappears, ask the robot
# to wake and re-enable its camera (at most once per minute).
EBO_AUTO_WAKE=true
# Health is false if either RTSP track has not produced data within this window.
EBO_MEDIA_STALE_AFTER_SECONDS=20
EBO_MEDIA_STARTUP_GRACE_SECONDS=45
