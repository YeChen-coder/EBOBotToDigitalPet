# EBO transport + Specter framework. Set secrets locally; never copy Specter memory or faces.
EBO_EMAIL=
EBO_PASSWORD=
EBO_PAYLOAD_KEY=
EBO_SIGN_KEY=
EBO_HOST_IP=
# Match the region and cloud host to your EBO HOME account; existing local values are retained.
EBO_REGION=GB
EBO_CLOUD_HOST=ebox-eu.enabotserverintl.com
EBO_HOST_LOG_PATH=/data/logs/ebo-engine.log
EBO_HOST_LOG_MAX_BYTES=10485760
EBO_HOST_LOG_BACKUP_COUNT=5
EBO_AGORA_AEC_ENABLED=false
EBO_AGORA_NOISE_SUPPRESSION_ENABLED=false
EBO_AGORA_AGC_ENABLED=false
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_OUTPUT_SPEED=1.0
OPENAI_INPUT_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_INPUT_TRANSCRIPTION_DELAY=
OPENAI_INPUT_TRANSCRIPTION_KEYWORDS_JSON=[]
OPENAI_INPUT_TRANSCRIPTION_LANGUAGE=
OPENAI_INPUT_TRANSCRIPTION_LANGUAGES_JSON=[]
OPENAI_INPUT_TRANSCRIPTION_PROMPT=
OPENAI_LIVE_TRANSCRIPTION_ENABLED=true
OPENAI_LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_LIVE_TRANSCRIPTION_DELAY=low
OPENAI_LIVE_TRANSCRIPTION_LANGUAGES_JSON=["zh"]
OPENAI_LIVE_TRANSCRIPTION_PROMPT=
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_TIMEOUT_SECONDS=90
EBO_ASSISTANT_INSTRUCTIONS=
EBO_API_TOKEN=
EBO_ASSISTANT_CONTROL_TOKEN=
EBO_NODE=ebo
EBO_API_URL=http://ebo-engine:8098
EBO_RTSP_URL=rtsp://ebo-engine:8554/ebo
EBO_TALK_STREAM_URL=ws://ebo-engine:8200/talk
# Empty uses /listen on the talkback host/port; microphone capture is independent of video.
EBO_AUDIO_STREAM_URL=
EBO_ASSISTANT_AUDIO_URL=http://realtime-assistant:8099/audio
EBO_STREAM_PREBUFFER_MS=200
EBO_STREAM_CONNECT_TIMEOUT_SECONDS=10
EBO_AUTO_WAKE=true
EBO_FRIGATE_URL=http://frigate:5000
EBO_CAMERA_NAME=ebo
EBO_MQTT_HOST=mosquitto
EBO_MQTT_PORT=1883
EBO_USERS_JSON='[{"id":"father","face_name":"爸爸","display_name":"爸爸"},{"id":"mother","face_name":"妈妈","display_name":"妈妈"}]'
EBO_PROACTIVE_GREETING_ENABLED=false
EBO_VOICE_WAKE_ENABLED=true
EBO_PLAYBACK_TAIL_MS=800
EBO_VISUAL_ENABLED=true
EBO_MIN_FACE_SCORE=0.90
EBO_MIN_PERSON_AREA=40000
EBO_ABSENCE_SECONDS=25
EBO_COOLDOWN_SECONDS=90
EBO_SESSION_IDLE_SECONDS=600
EBO_SESSION_MAX_SECONDS=2700
EBO_SERVER_NOISE_REDUCTION=far_field
REALTIME_VAD_THRESHOLD=0.65
EBO_VAD_PREFIX_PADDING_MS=300
EBO_VAD_SILENCE_DURATION_MS=650
EBO_BARGE_IN_ENABLED=false
EBO_BARGE_IN_CONFIRM_MS=300
EBO_BARGE_IN_PREROLL_MS=500
EBO_BARGE_IN_VAD_MODE=2
EBO_BARGE_IN_ECHO_CORRELATION=0.65
EBO_BARGE_IN_RESIDUAL_RATIO=0.45
EBO_AEC_ENABLED=true
EBO_AEC_DELAY_MS=0
EBO_AEC_WARMUP_MS=500
REALTIME_IMAGE_WIDTH=768
REALTIME_IMAGE_QUALITY=75
EBO_TRACE_ENABLED=false
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=false
EBO_MEDIA_STALE_AFTER_SECONDS=20
EBO_MEDIA_STARTUP_GRACE_SECONDS=90
EBO_TRANSCRIPT_PATH=/data/transcripts.jsonl
EBO_LIVE_TRANSCRIPT_PATH=/data/live_transcripts.jsonl
EBO_OUTPUT_AUDIO_DIR=/data/replies
EBO_ASSISTANT_TRANSCRIPT_PATH=/data/assistant_outputs.jsonl
EBO_MEMORY_ROOT=/data/memory-v2
EBO_MEMORY_MODEL=gpt-5.4-mini
EBO_MEMORY_TIMEOUT_SECONDS=45
EBO_LONG_TERM_MEMORY_MODEL=gpt-6-sol
EBO_LONG_TERM_MEMORY_TIMEOUT_SECONDS=120
EBO_MEMORY_CONSOLIDATION_HOURS=24
EBO_REALTIME_MEMORY_MAX_CHARS=6000
TZ=America/Toronto
