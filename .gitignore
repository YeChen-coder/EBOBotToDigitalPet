.env
ebo-data/*
!ebo-data/.gitkeep
homeassistant-config/.storage/
homeassistant-config/.cloud/
homeassistant-config/.HA_VERSION
homeassistant-config/*.db*
homeassistant-config/*.log*
homeassistant-config/tts/
homeassistant-config/deps/
homeassistant-config/secrets.yaml
media/*
!media/.gitkeep
private/
assistant-data/
realtime-assistant/debug-output/
**/__pycache__/
*.py[cod]
homeassistant-config/.cache/
homeassistant-config/.ha_run.lock
homeassistant-config/llmvision/*.db*

# Local checkpoints exclude credentials, editor locks and generated document QA.
**/.env.*
!**/.env.example
**/~$*
.pytest_cache/
.ruff_cache/
docs/_bilingual_build/*.json
docs/_bilingual_build/*.pdf
docs/_bilingual_build/artifact.md
docs/_bilingual_build/reference.docx
docs/_bilingual_build/reference_render/
docs/_bilingual_build/render_*/
docs/_bilingual_build/figures/
